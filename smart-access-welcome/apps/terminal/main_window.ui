<?xml version="1.0" encoding="UTF-8"?>
<ui version="4.0">
 <class>MainWindow</class>
 <widget class="QMainWindow" name="MainWindow">
  <property name="geometry">
   <rect><x>0</x><y>0</y><width>1440</width><height>900</height></rect>
  </property>
  <property name="minimumSize"><size><width>1180</width><height>760</height></size></property>
  <property name="windowTitle"><string>Smart Access · 智能门禁终端</string></property>
  <property name="styleSheet">
   <string notr="true">QMainWindow { background: #07111F; }
QWidget#centralWidget { background: #07111F; color: #E8F1F8; font-family: "Microsoft YaHei UI"; font-size: 14px; }
QFrame#topBar { background: #0B1828; border: 1px solid #17304A; border-radius: 16px; }
QLabel#logoMark { background: #16A3D6; color: #FFFFFF; border-radius: 12px; font-size: 20px; font-weight: 700; }
QLabel#productName { color: #F4FAFF; font-size: 18px; font-weight: 700; }
QLabel#headerClockLabel, QLabel[role="muted"] { color: #7690A6; }
QLabel[role="sectionTitle"] { color: #F4FAFF; font-size: 18px; font-weight: 700; }
QLabel[role="body"] { color: #AEC0CF; line-height: 1.4; }
QLabel[role="status"] { padding: 7px 12px; border-radius: 11px; font-size: 12px; font-weight: 700; }
QLabel[status="ready"] { color: #64E6AF; background: #123A35; border: 1px solid #1C5E4E; }
QLabel[status="active"] { color: #6DD7FF; background: #10344A; border: 1px solid #1B5876; }
QLabel[status="warning"] { color: #FFD27A; background: #3B311B; border: 1px solid #665025; }
QLabel[status="offline"] { color: #91A6B8; background: #142332; border: 1px solid #263E53; }
QFrame#cameraCard, QFrame#controlPanel { background: #0B1828; border: 1px solid #17304A; border-radius: 18px; }
QFrame#previewShell { background: #040A12; border: 1px solid #1A344B; border-radius: 14px; }
QLabel#videoLabel { color: #6E879B; background: transparent; font-size: 16px; border: none; }
QFrame[role="metric"] { background: #0E2032; border: 1px solid #183A54; border-radius: 12px; }
QLabel[role="metricLabel"] { color: #6F8AA0; font-size: 11px; }
QLabel[role="metricValue"] { color: #E8F6FF; font-size: 14px; font-weight: 700; }
QLabel[role="fieldLabel"] { color: #91A9BB; font-size: 12px; font-weight: 600; }
QComboBox, QSpinBox { min-height: 40px; color: #E8F1F8; background: #0E2032; border: 1px solid #28475E; border-radius: 10px; padding: 0 12px; selection-background-color: #167DA5; }
QComboBox:hover, QSpinBox:hover { border-color: #3A789A; }
QComboBox:focus, QSpinBox:focus { border: 1px solid #29B5E8; }
QComboBox::drop-down { border: none; width: 30px; }
QComboBox QAbstractItemView { color: #E8F1F8; background: #102235; border: 1px solid #31546C; selection-background-color: #176D8E; outline: none; }
QPushButton { min-height: 42px; border-radius: 11px; padding: 0 18px; font-weight: 700; }
QPushButton#openButton, QPushButton#recognizeButton { color: #03121A; background: #5ED8FF; border: 1px solid #72DEFF; }
QPushButton#openButton:hover, QPushButton#recognizeButton:hover { background: #83E2FF; }
QPushButton#enrollButton { color: #DAF5FF; background: #123B52; border: 1px solid #246582; }
QPushButton#enrollButton:hover { background: #194C67; }
QPushButton#closeButton { color: #FFB9B9; background: #321D26; border: 1px solid #623242; }
QPushButton#closeButton:hover { background: #472431; }
QPushButton:disabled { color: #526879; background: #102030; border-color: #1B3347; }
QFrame[role="divider"] { color: #17304A; background: #17304A; max-height: 1px; }
QStatusBar { color: #7891A5; background: #081522; border-top: 1px solid #152C40; font-family: "Microsoft YaHei UI"; }
QStatusBar::item { border: none; }</string>
  </property>
