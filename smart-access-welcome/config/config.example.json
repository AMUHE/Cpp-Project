{
  "schemaVersion": 1,
  "device": {
    "id": "terminal-demo-01",
    "displayName": "一号门智能终端"
  },
  "camera": {
    "mode": "single_device",
    "primaryIndex": 0,
    "secondaryIndex": 1,
    "frameWidth": 1280,
    "frameHeight": 720,
    "captureIntervalMs": 30
  },
  "recognition": {
    "confidenceThreshold": 80.0,
    "requiredConsecutiveMatches": 3,
    "eventCooldownSeconds": 10
  },
  "server": {
    "bindAddress": "127.0.0.1",
    "httpPort": 8080
  },
  "welcome": {
    "displayDurationSeconds": 5,
    "defaultText": "请面向摄像头",
    "grantedTemplate": "欢迎，{displayName}"
  },
  "speech": {
    "enabled": true,
    "locale": "zh_CN",
    "rate": 0.0,
    "volume": 1.0,
    "grantedTemplate": "欢迎，{displayName}",
    "deniedText": "未识别，请联系管理员"
  },
  "storage": {
    "databaseFile": "access.db",
    "retentionDays": 90
  }
}
